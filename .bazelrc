build --stamp
build --workspace_status_command tools/workspace-status.sh
build --define RELEASE=devel

build:prod --define RELEASE=prod

# Show us information about failures.
build --verbose_failures
test --test_output=errors

# Make /tmp hermetic
build --sandbox_tmpfs_path=/tmp

# Ensure that Bazel never runs as root, which can cause unit tests to fail.
# This flag requires Bazel 0.5.0+
build --sandbox_fake_username

# Enable go race detection.
test:unit --features=race
test:unit --flaky_test_attempts=3

# Preserve Bazel 7 behavior for optional file globs under Bazel 8.
common --incompatible_disallow_empty_glob=false

# Legacy WORKSPACE dependencies are still used (no MODULE.bazel); Bazel 8 disables WORKSPACE by default.
common --enable_workspace=true
common --noenable_bzlmod

# rules_docker image platform transition is incompatible with Bazel 8; build platforms are selected explicitly.
build --@io_bazel_rules_docker//transitions:enable=false
